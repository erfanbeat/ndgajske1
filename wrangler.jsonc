{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ndgajske1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3bf71984-4502-469a-93fc-32018be95571","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d970149714a24597b5325d9bf51de955" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
